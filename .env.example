# Copy to .env for a local Nuxt server; never commit your real .env file.
# SMTP must be configured on the server host for direct form delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
CONTACT_FROM=Jordan Portfolio <portfolio@your-domain.com>
CONTACT_TO=you@your-domain.com

# Optional canonical website URL (replace with the final real URL before build)
NUXT_PUBLIC_SITE_URL=
